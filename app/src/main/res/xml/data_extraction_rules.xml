<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="pdf_directories" />
        <include domain="file" path="library/roots.json" />
        <include domain="file" path="thumbs" />
        <include domain="file" path="recent_books.json" />
        <include domain="sharedpref" path="mk_pdf_settings.xml" />
        <include domain="sharedpref" path="mk_pdf_stats.xml" />
        <include domain="database" path="mk_pdf_reader.db" />

        <exclude domain="file" path="toc_cache" />
        <exclude domain="file" path="lib_thumbs" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="pdf_directories" />
        <include domain="file" path="library/roots.json" />
        <include domain="file" path="thumbs" />
        <include domain="file" path="recent_books.json" />
        <include domain="sharedpref" path="mk_pdf_settings.xml" />
        <include domain="sharedpref" path="mk_pdf_stats.xml" />
        <include domain="database" path="mk_pdf_reader.db" />

        <exclude domain="file" path="toc_cache" />
        <exclude domain="file" path="lib_thumbs" />
    </device-transfer>
</data-extraction-rules>
